+def _physical_spacing_vector(
+    spacing: int | float | np.ndarray | Sequence[int | float | np.ndarray | Sequence[int | float]] | None,
+    img_dim: int,
+) -> np.ndarray:
+    """
+    Normalize the per-image spacing supplied to a vector of physical spacings with one entry
+    per image axis. A scalar denotes isotropic spacing; a sequence provides the spacing of each
+    axis in the same order as the spatial dimensions of the input tensor.
+    """
+    if spacing is None:
+        return np.ones(img_dim, dtype=np.float64)
+    if isinstance(spacing, (int, float, np.integer, np.floating)):
+        return np.full(img_dim, float(spacing), dtype=np.float64)
+    arr = np.asarray(spacing, dtype=np.float64).reshape(-1)
+    if arr.size == 1:
+        arr = np.full(img_dim, float(arr[0]), dtype=np.float64)
+    if arr.size != img_dim:
+        raise ValueError(f"spacing must contain {img_dim} values (one per image axis), got {arr.size}.")
+    return arr
+
+
+def _surface_face_elements(
+    fg: np.ndarray, edges: np.ndarray, spacing: np.ndarray
+) -> tuple[np.ndarray, np.ndarray]:
+    """
+    Surface elements of the sampled boundary of a binary mask.
+
+    Each face (in 2D: each edge) shared between a foreground boundary voxel and a background
+    face-neighbour is one surface element of the sampled boundary. For every element this
+    function returns its representative point (the physical centre of the face, in physical
+    coordinates derived from the supplied spacing) and its physical measure (the length of the
+    edge in 2D, the area of the face in 3D). Summing the measures over all elements yields the
+    physical length/area of the sampled (staircase) surface, and every surface element is
+    counted exactly once, so the same convention can be used for the total boundary and for the
+    portion of it that lies within tolerance.
+
+    Args:
+        fg: binary foreground mask of the image (spatial shape only).
+        edges: boolean mask of boundary voxels (e.g. from :func:`monai.metrics.utils.get_mask_edges`).
+        spacing: physical spacing of the image, one value per spatial axis.
+
+    Returns:
+        A pair ``(centers, measures)`` where ``centers`` has shape ``(N, d)`` with the physical
+        coordinates of the element centres and ``measures`` has shape ``(N,)`` with the physical
+        measure of each element.
+    """
+    fg = np.asarray(fg).astype(bool)
+    edges = np.asarray(edges).astype(bool)
+    spacing = np.asarray(spacing, dtype=np.float64)
+    dim = fg.ndim
+    centers: list[np.ndarray] = []
+    measures: list[np.ndarray] = []
+    for ax in range(dim):
+        face_measure = float(np.prod([spacing[k] for k in range(dim) if k != ax]))
+        pad_width = [(0, 0)] * dim
+        pad_width[ax] = (1, 1)
+        padded = np.pad(fg, pad_width, mode="constant", constant_values=False)
+        for face_offset in (0, 1):
+            neighbour = [slice(None)] * dim
+            neighbour[ax] = slice(2, None) if face_offset == 1 else slice(None, -2)
+            face = edges & ~padded[tuple(neighbour)]
+            if not face.any():
+                continue
+            idx = np.argwhere(face)
+            centre = (idx.astype(np.float64) + 0.5) * spacing
+            centre[:, ax] = (idx[:, ax] + face_offset) * spacing[ax]
+            centers.append(centre)
+            measures.append(np.full(len(idx), face_measure, dtype=np.float64))
+    if not centers:
+        return np.empty((0, dim), dtype=np.float64), np.empty(0, dtype=np.float64)
+    return np.vstack(centers), np.concatenate(measures)
+
+
+def _surface_elements_within_tolerance(src: np.ndarray, dst: np.ndarray, tolerance: float) -> np.ndarray:
+    """
+    Exact directed tolerance test between two sets of surface elements.
+
+    Args:
+        src: ``(N, d)`` array of physical coordinates of the source surface elements.
+        dst: ``(M, d)`` array of physical coordinates of the target surface elements.
+        tolerance: physical distance threshold.
+
+    Returns:
+        A boolean array of shape ``(N,)``: entry ``i`` is True when the Euclidean distance in
+        physical space from ``src[i]`` to the nearest target element is at most ``tolerance``.
+        If the target set is empty, all entries are False.
+    """
+    src = np.asarray(src, dtype=np.float64)
+    dst = np.asarray(dst, dtype=np.float64)
+    n_src = len(src)
+    if n_src == 0:
+        return np.empty(0, dtype=bool)
+    if len(dst) == 0:
+        return np.zeros(n_src, dtype=bool)
+    tol2 = float(tolerance) * float(tolerance)
+    eps = 1e-9 * max(1.0, tol2)
+    # reject sources that are farther than `tolerance` from the target bounding box
+    lo = dst.min(axis=0)
+    hi = dst.max(axis=0)
+    gap = np.maximum(np.maximum(lo - src, src - hi), 0.0)
+    active = np.flatnonzero((gap * gap).sum(axis=1) <= tol2 + eps)
+    out = np.zeros(n_src, dtype=bool)
+    if len(active) == 0:
+        return out
+    dim = src.shape[1]
+    span = float(np.max(hi - lo))
+    cell = max(span / 16.0, 1e-9)
+    window = int(np.ceil(float(tolerance) / cell)) + 1
+    # fall back to a direct (chunked) comparison when the search window would be large
+    if (2 * window + 1) ** dim > max(4096, 4 * len(dst)):
+        chunk = max(8, int(1.6e7 // max(1, len(dst) * dim)))
+        for i0 in range(0, len(active), chunk):
+            sel = active[i0 : i0 + chunk]
+            d2 = ((src[sel][:, None, :] - dst[None, :, :]) ** 2).sum(axis=2)
+            out[sel] = d2.min(axis=1) <= tol2 + eps
+        return out
+    # spatial hash of the target elements for local lookups; the window is scanned
+    # from the centre outwards so that dense target sets are resolved after few cells
+    buckets: dict[tuple, list] = {}
+    dst_cell = (dst / cell).astype(np.int64)
+    for i in range(len(dst)):
+        buckets.setdefault(tuple(int(v) for v in dst_cell[i]), []).append(i)
+    offsets = sorted(
+        product(*[range(-window, window + 1)] * dim),
+        key=lambda off: (max(abs(v) for v in off), sum(v * v for v in off)),
+    )
+    for i in active:
+        base = (src[i] / cell).astype(np.int64)
+        for off in offsets:
+            idx = buckets.get(tuple(int(base[k] + off[k]) for k in range(dim)))
+            if idx is None:
+                continue
+            d2 = (dst[idx] - src[i]) ** 2
+            if d2.sum(axis=1).min() <= tol2 + eps:
+                out[i] = True
+                break
+    return out
+
