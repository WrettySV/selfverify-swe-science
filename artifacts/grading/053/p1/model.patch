+def _surface_face_distances(
+    mask: np.ndarray,
+    reference: np.ndarray,
+    spacing: int | float | np.ndarray | Sequence[int | float],
+    threshold: float,
+) -> tuple[np.ndarray, np.ndarray]:
+    """
+    Directed physical surface distances and boundary measures of a sampled solid.
+
+    The binary ``mask`` is interpreted as the union of the voxel cubes of the voxels
+    set to one, with physical spacing ``spacing`` along each axis. Every voxel that
+    touches a position outside the solid (positions outside the image count as
+    outside) contributes one boundary face per such contact. For each face this
+    returns
+
+    * the physical distance from the face to the surface of the binary
+      ``reference`` solid, i.e. the smallest distance between the face and the
+      surface formed by the voxel cubes of the reference. A face lying on the
+      reference surface has distance zero;
+    * the measure of the face, i.e. its length for 2-D inputs and its area for
+      3-D inputs, in the physical units of ``spacing``.
+
+    Both quantities are expressed in the physical units of ``spacing``, so the
+    ratio of in-tolerance boundary measure to total boundary measure approximates
+    the physical surface overlap of the two surfaces independently of the grid
+    resolution used to sample them.
+    """
+    ndim = mask.ndim
+    spacing = np.asarray(spacing, dtype=np.float64).ravel()
+    if spacing.size == 1:
+        spacing = np.full(ndim, float(spacing[0]), dtype=np.float64)
+    if spacing.size != ndim:
+        raise ValueError(
+            f"spacing must have one entry per spatial dimension, got {spacing.size} for a {ndim}D input."
+        )
+
+    # Collect the boundary faces of the mask: for every axis direction, the
+    # voxels of the mask whose neighbor in that direction is outside the solid.
+    padded_mask = np.pad(mask, 1, constant_values=False)
+    inside_parts: list[np.ndarray] = []
+    outside_parts: list[np.ndarray] = []
+    axis_parts: list[np.ndarray] = []
+    for axis in range(ndim):
+        for side in ("p", "m"):
+            neighbor = [slice(1, -1)] * ndim
+            neighbor[axis] = slice(2, None) if side == "p" else slice(0, -2)
+            index = np.argwhere(mask & ~padded_mask[tuple(neighbor)])
+            if not index.size:
+                continue
+            inside = index.copy()
+            outside = index.copy()
+            outside[:, axis] += 1 if side == "p" else -1
+            inside_parts.append(inside)
+            outside_parts.append(outside)
+            axis_parts.append(np.full(index.shape[0], axis, dtype=np.int64))
+
+    if not inside_parts:
+        empty = np.empty((0,), dtype=np.float64)
+        return empty, empty
+
+    inside = np.vstack(inside_parts)
+    outside = np.vstack(outside_parts)
+    axis = np.concatenate(axis_parts)
+
+    # Measure of each face: length in 2-D, area in 3-D, in physical units.
+    measures = np.ones(inside.shape[0], dtype=np.float64)
+    for a in range(ndim):
+        measures = np.where(axis == a, 1.0, spacing[a]) * measures
+
+    # Faces whose endpoints lie on opposite sides of the reference solid lie on
+    # the reference surface itself.
+    padded_reference = np.pad(reference, 1, constant_values=False)
+    reference_inside = reference[tuple(inside[:, a] for a in range(ndim))]
+    reference_outside = padded_reference[tuple(outside[:, a] + 1 for a in range(ndim))]
+    on_surface = reference_inside != reference_outside
+    strictly_inside = reference_inside & reference_outside
+    strictly_outside = ~reference_inside & ~reference_outside
+
+    distances = np.zeros(inside.shape[0], dtype=np.float64)
+    if np.any(strictly_inside) or np.any(strictly_outside):
+        image_diag = float(np.linalg.norm(spacing * (np.asarray(mask.shape, dtype=np.float64) - 1.0)))
+        if threshold >= image_diag and np.any(reference):
+            # Every point of the image is within `threshold` of the reference
+            # surface, so every boundary face is within the threshold as well.
+            return distances, measures
+
+        # Local search radius (in voxels) around each face that can contain a
+        # cube of the opposite side within `threshold` of the face.
+        radius = (np.ceil(np.asarray(threshold, dtype=np.float64) / spacing) + 1).astype(np.int64)
+        box_shape = tuple(2 * int(r) + 1 for r in radius)
+        for selected, opposite in ((strictly_outside, padded_reference), (strictly_inside, ~padded_reference)):
+            if not np.any(selected):
+                continue
