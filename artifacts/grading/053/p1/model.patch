+            plane = (np.minimum(inside, outside) + 1) * spacing
+            centers = inside + 1  # padded coordinates of the face voxels
+            chunk_size = max(1, min(int(selected.sum()), int(16 * 1024 * 1024 / max(int(np.prod(box_shape)), 1))))
+            for normal_axis in range(ndim):
+                sel = np.flatnonzero(selected & (axis == normal_axis))
+                if sel.size == 0:
+                    continue
+                c = centers[sel].astype(np.int64)
+                fc = (inside[sel].astype(np.float64)) * spacing  # face voxel origins in physical units
+                fa = fc[:, normal_axis]
+                face_plane = plane[sel, normal_axis]
+                m = sel.size
+                for start in range(0, m, chunk_size):
+                    stop = min(start + chunk_size, m)
+                    s0 = slice(start, stop)
+                    cc = c[s0]
+                    # Broadcast index arrays for the local box around each face.
+                    idx = []
+                    for a in range(ndim):
+                        offset = np.arange(-int(radius[a]), int(radius[a]) + 1, dtype=np.int64)
+                        base = cc[:, a].reshape([-1] + [1] * ndim)
+                        off = offset.reshape([1] * (a + 1) + [-1] + [1] * (ndim - 1 - a))
+                        idx.append(np.clip(base + off, 0, opposite.shape[a] - 1))
+                    gathered = opposite[tuple(idx)]
+                    gap_sq = np.zeros((cc.shape[0],) + box_shape, dtype=np.float64)
+                    for a in range(ndim):
+                        j = idx[a]
+                        cube_lo = (j - 1).astype(np.float64) * spacing[a]
+                        cube_hi = j.astype(np.float64) * spacing[a]
+                        if a == normal_axis:
+                            pl = face_plane[s0].reshape([-1] + [1] * ndim)
+                            gap = np.maximum(0.0, np.maximum(cube_lo - pl, pl - cube_hi))
+                        else:
+                            f_lo = fc[s0, a].reshape([-1] + [1] * ndim)
+                            f_hi = (fc[s0, a] + spacing[a]).reshape([-1] + [1] * ndim)
+                            gap = np.maximum(0.0, np.maximum(cube_lo - f_hi, f_lo - cube_hi))
+                        gap_sq += gap * gap
+                    gap = np.where(gathered, np.sqrt(gap_sq), np.inf)
+                    distances[sel[s0]] = gap.min(axis=tuple(range(1, ndim + 1)))
+    return distances, measures
+
