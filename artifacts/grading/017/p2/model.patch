+    def _integrate_closest_approach(
+        self, impact, rmin, rmax, unit, ndecade, squared
+    ):
+        r"""Line-of-sight integral of a radial branch at r >= b.
+
+        Uses the substitution r = b cosh(t), which maps the closest approach
+        to t = 0 and removes the integrable endpoint singularity of the
+        line-of-sight jacobian from the numerical quadrature:
+
+        .. math::
+            \int_{r_{\min}}^{r_{\max}} \rho(r)^\gamma
+            \frac{r}{\sqrt{r^2 - b^2}} \, dr
+            = \int_{\operatorname{arcosh}(r_{\min}/b)}^{
+              \operatorname{arcosh}(r_{\max}/b)}
+            \rho(b \cosh t)^\gamma \, b \cosh t \, dt
+        """
+        exponent = 2 if squared else 1
+        # Clamp against floating-point round-off: a lower bound a hair below
+        # the closest approach is numerically indistinguishable from it.
+        t_min = np.arccosh(max(rmin / impact, 1.0))
+        t_max = np.arccosh(rmax / impact)
+        n = max(
+            8,
+            int(
+                (np.log10(rmax / rmin) + (t_max - t_min) / np.log(10.0)) * ndecade
+            ),
+        )
+        t = np.linspace(t_min, t_max, n)
+        cosh_t = np.cosh(t)
+        radius = impact * cosh_t * unit
+        with np.errstate(divide="ignore", invalid="ignore"):
+            density = self(radius).to_value("GeV / cm3") ** exponent
+        value = np.trapezoid(density * impact * cosh_t, t)
+        return u.Quantity(value, u.Unit("GeV / cm3") ** exponent * unit)
+
+    def _integrate_radial(self, rmin, rmax, unit, ndecade, squared):
+        """Direct radial integral of the profile over [rmin, rmax].
+
+        Limiting case for a vanishing impact parameter b = 0, where the
+        line-of-sight jacobian r / sqrt(r^2 - b^2) tends to unity and the
+        r = b cosh(t) substitution degenerates. The original radial interval
+        is integrated directly, keeping the requested lower and upper
+        bounds. If the lower bound is at the origin, a log-spaced grid
+        resolves the inner region down to sub-physical scales and a single
+        trapezoidal segment [0, r_head] closes the interval at the origin.
+        """
+        exponent = 2 if squared else 1
+        density_unit = u.Unit("GeV / cm3") ** exponent
+        if rmin > 0:
+            n = max(8, int((np.log10(rmax / rmin)) * ndecade))
+            radius = np.geomspace(rmin, rmax, n) * unit
+            with np.errstate(divide="ignore", invalid="ignore"):
+                density = (
+                    self(radius).to_value("GeV / cm3") ** exponent * density_unit
+                )
+            return trapz_loglog(density, radius).sum()
+        head = rmax * 1e-10
+        n = max(8, int(10.0 * ndecade))
+        radius = np.geomspace(head, rmax, n) * unit
+        with np.errstate(divide="ignore", invalid="ignore"):
+            density = (
+                self(radius).to_value("GeV / cm3") ** exponent * density_unit
+            )
+            density0 = (
+                self(np.zeros(1) * unit).to_value("GeV / cm3")[0]
+                ** exponent
+                * density_unit
+            )
+        return trapz_loglog(density, radius).sum() + 0.5 * (
+            density0 + density[0]
+        ) * (head * unit)
+
 
