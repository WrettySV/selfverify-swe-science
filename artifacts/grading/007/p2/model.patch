+    of data relative to reference and aligned is the full transient corrected
+    so that it matches the reference.
+    """
+    n = data.np
+    df = data.df
+    sw = data.sw
+    spec = numpy.fft.fftshift(numpy.fft.fft(data))
+    refspec = numpy.fft.fftshift(numpy.fft.fft(reference))
+    if window_weights is None:
+        window_full = numpy.ones(n)
+    else:
+        window_full = window_weights
+    index = numpy.flatnonzero(window_full)
+    w = window_full[index]
+    weighted_ref = w * refspec[index]
+    ref_energy = float(numpy.sum(w * numpy.abs(refspec[index]) ** 2))
+
+    # circular cross-correlations on the native frequency grid give the
+    # phase-optimised mismatch for every integer-bin shift, including negative
+    # shifts: cost(s) = <w|A_s|^2> + <w|B|^2> - 2|<A_s, B>_w| with A_s the
+    # spectrum circularly shifted by s bins (s * df Hz)
+    inner = numpy.fft.ifft(numpy.conj(numpy.fft.fft(spec)) * numpy.fft.fft(window_full * refspec))
+    energy = numpy.fft.ifft(
+        numpy.fft.fft(numpy.abs(spec) ** 2) * numpy.conj(numpy.fft.fft(window_full))
+    )
+    n_shifts = n
+    shift_costs = energy.real[(-numpy.arange(n_shifts)) % n] + ref_energy - 2.0 * numpy.abs(inner[:n_shifts])
+
+    def shift_frequency(s):
+        frequency = s * df
+        if frequency > sw / 2.0:
+            frequency -= sw
+        return frequency
+
+    # distinct local minima of the scan: candidate alignment basins
+    minima = []
+    for s in range(n_shifts):
+        left = shift_costs[(s - 1) % n_shifts]
+        right = shift_costs[(s + 1) % n_shifts]
+        if shift_costs[s] < left and shift_costs[s] <= right:
+            frequency = shift_frequency(s)
+            phase = float(numpy.angle(inner[s]) / (2.0 * numpy.pi))
+            minima.append((float(shift_costs[s]), frequency, phase))
+    minima.sort(key=lambda candidate: candidate[0])
+    basins = minima[:20]
+
