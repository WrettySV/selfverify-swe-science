+def _registration_weights(reference, frequency_range):
+    """
+    Resolve a frequency_range specification into an explicit registration
+    window: the indices of the spectral points to use and their (positive)
+    weightings.
+
+    Returns None when the whole spectrum should be used, which also covers the
+    degenerate case of a window that contains no spectral points.
+    """
+    if frequency_range is None:
+        return None
+    if type(frequency_range) is tuple:
+        axis = reference.frequency_axis()
+        support = numpy.logical_and(axis > frequency_range[0], axis < frequency_range[1])
+        values = None
+    else:
+        values = numpy.asarray(frequency_range, dtype=float)
+        if values.shape != reference.shape:
+            raise ValueError("frequency_range array must have the same shape as the data")
+        support = values != 0
+    index = numpy.flatnonzero(support)
+    if index.size == 0:
+        return None
+    if values is None:
+        values = numpy.ones(index.size)
+    else:
+        values = values[index]
+    return index, values
+
+
+def _window_mismatch(aligned_spectrum, index, weights, weighted_reference, reference_energy):
+    """
+    Phase-optimised, window-weighted least-squares mismatch between an aligned
+    spectrum and the reference, plus the optimal phase (in cycles).
+
+    Minimising |exp(2j*pi*p) * A - B|^2 over p in the window gives the closed
+    form |A|^2 + |B|^2 - 2|<A, B>| with p = angle(<A, B>) / (2*pi).
+    """
+    window = aligned_spectrum[index]
+    inner = numpy.sum(numpy.conj(window) * weighted_reference)
+    energy = float(numpy.sum(weights * numpy.abs(window) ** 2))
+    cost = energy + reference_energy - 2.0 * abs(inner)
+    phase = float(numpy.angle(inner) / (2.0 * numpy.pi))
+    return cost, phase
+
+
+def _alias_distance(frequency, other, sw):
+    return abs(((frequency - other + sw / 2.0) % sw) - sw / 2.0)
+
+
+def _coarse_alignment(data, reference, window_weights, initial_guess, frequency_range=None):
+    """
+    Robust global search for the frequency and phase drift between data and
+    reference within the registration window.
+
+    Circular cross-correlation on the native frequency grid evaluates the
+    phase-optimised least-squares mismatch for every integer frequency-bin
+    shift of the full spectral width in a single pair of FFTs, so positive and
+    negative drifts of any magnitude within the spectral width are covered. The most significant distinct
+    basins are then scanned with a sub-bin grid and polished with a local
+    least-squares refinement restricted to the same window, so the result does
+    not depend on the quality of the supplied drift guess.
+
