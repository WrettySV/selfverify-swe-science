+        guess = ((guess + sw / 2.0) % sw) - sw / 2.0
+        aligned_spec = numpy.fft.fftshift(numpy.fft.fft(data * numpy.exp(2j * numpy.pi * guess * time_axis)))
+        cost, phase = _window_mismatch(aligned_spec, index, w, weighted_ref, ref_energy)
+        starts.append((cost, guess, phase))
+    starts.sort(key=lambda candidate: candidate[0])
+
+    # polish the best, well-separated candidates locally and keep the overall
+    # best result
+    best = None
+    seen = []
+    for cost, frequency, phase in starts:
+        if any(_alias_distance(frequency, other, sw) < df / 2.0 for other in seen):
+            continue
+        seen.append(frequency)
+        drift = spectral_registration(
+            data,
+            reference,
+            initial_guess=(frequency, phase),
+            frequency_range=frequency_range,
+        )
+        aligned = transform_fid(data, -drift[0], -drift[1])
+        aligned_spec = numpy.fft.fftshift(numpy.fft.fft(aligned))
+        refined_cost, _ = _window_mismatch(aligned_spec, index, w, weighted_ref, ref_energy)
+        if best is None or refined_cost < best[0]:
+            best = (refined_cost, aligned, drift[0], drift[1])
+    return best[1], best[2], best[3]
