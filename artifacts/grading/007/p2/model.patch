+    # missed between integer bins, plus the supplied drift guess (in both sign
+    # conventions) and no frequency shift at all
+    time_axis = numpy.arange(n) * data.dt
+    starts = []
+    for cost, frequency, phase in basins:
+        fine = []
+        for offset in numpy.arange(-1.25, 1.26, 0.125):
+            candidate = ((frequency + offset * df + sw / 2.0) % sw) - sw / 2.0
+            aligned_spec = numpy.fft.fftshift(numpy.fft.fft(data * numpy.exp(2j * numpy.pi * candidate * time_axis)))
