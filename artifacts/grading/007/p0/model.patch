+        weights = numpy.asarray(weights)
+        if not numpy.any(weights != 0):
+            return False
+        weighted = spectrum * weights
+    else:
+        weighted = spectrum
+    power = numpy.vdot(weighted, weighted).real
+    total = numpy.vdot(spectrum, spectrum).real
