+def _search_radius(reference, data, weights, sweep_limit):
+    # Distance over which the windowed comparison is still well posed:
+    # the nearest significant spectral feature outside the comparison region
+    # (looking at the reference and at the data), limited to the half sweep.
+    n_points = reference.np
+    df = sweep_limit * 2.0 / n_points
+    if weights is None:
+        return sweep_limit
+    weights = numpy.asarray(weights)
+    in_window = weights != 0
+    if not numpy.any(in_window):
+        return sweep_limit
+
+    def feature_radius(spectrum):
+        magnitude = numpy.abs(spectrum)
+        threshold = 0.1 * float(magnitude.max())
+        outside = ~in_window
+        significant = outside & (magnitude > threshold)
+        if not numpy.any(significant):
+            return sweep_limit
+        window_bins = numpy.flatnonzero(in_window)
+        candidate_bins = numpy.flatnonzero(significant)
+        # cyclic distance in bins from each candidate to the nearest window bin
+        distances = numpy.min(
+            numpy.abs(
+                (candidate_bins[:, None] - window_bins[None, :]) % n_points
+            ),
+            axis=1,
+        )
+        nearest = numpy.min(distances)
+        # keep at least a modest correction range available
+        return max((nearest - 1.0) * df, 16.0 * df)
+
+    reference_radius = feature_radius(reference.spectrum())
+    data_radius = feature_radius(data.spectrum())
+    radius = min(reference_radius, data_radius)
+    return float(min(max(radius, 16.0 * df), sweep_limit))
+
+
+def _registration_window_is_usable(reference, weights):
+    # true when the comparison region contains at least one bin and the
+    # reference holds a meaningful signal there (a non-negligible fraction of
+    # the total reference power); otherwise no drift can be estimated
+    spectrum = reference.spectrum()
