+def _unfound_roots_are_nonreal(f, x, rs):
+    """Return True if all roots of f not in rs are provably non-real.
+
+    The roots in rs are removed from f (with multiplicity).  Every
+    remaining factor of degree one or more may have real roots,
+    except a quadratic factor whose discriminant is provably
+    non-positive, which has real roots only for degenerate
+    (lower-dimensional) parameter values.
+    """
+    remaining = f.as_expr()
+
+    for root, multiplicity in rs.items():
+        for _ in range(multiplicity):
+            remaining = cancel(remaining / (x - root))
+
+    try:
+        remaining = Poly(remaining, x)
+    except (PolynomialError, CoercionFailed, TypeError,
+            ZeroDivisionError, ValueError):
+        return False
+
+    if remaining.degree() == 0:
+        return True
+
+    try:
+        _, factors = remaining.factor_list()
+    except (PolynomialError, CoercionFailed, TypeError,
+            ZeroDivisionError, ValueError, NotImplementedError):
+        return False
+
+    for factor, _ in factors:
+        if factor.degree() > 2:
+            # an unfound factor of degree three or more may have
+            # real roots
+            return False
+        if factor.degree() == 1:
+            # an unfound linear factor has a real root
+            return False
+        coeffs = factor.all_coeffs()
+        discriminant = coeffs[1]**2 - 4*coeffs[0]*coeffs[2]
+        if discriminant.is_negative:
+            continue
+        if discriminant.is_nonpositive and discriminant != 0:
+            # the factor has real roots only for degenerate
+            # (lower-dimensional) parameter values
+            continue
+        return False
+
+    return True
+
+
+def _is_zero(expr):
+    """Test whether ``expr`` is zero.
+
+    A purely numerical expression is checked with ``evalf`` so that
+    floating point noise is tolerated.  An expression with free symbols
+    must be tested exactly: ``evalf`` only evaluates the numerical
+    coefficients and cannot prove that such an expression vanishes
+    identically.
+    """
+    if expr == 0:
+        return True
+    if not expr.free_symbols:
+        return expr.evalf(chop=True) == 0
+    try:
+        return cancel(expr) == 0
+    except (PolynomialError, CoercionFailed, TypeError, NotImplementedError):
+        return expr.simplify() == 0
+
