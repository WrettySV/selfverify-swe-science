+def _synthetic_dynamic_series(drifts, noise, nuisance=None, corrupt_index=None, seed=0):
+    # small MRS-like series: a common multi-peak reference with per-transient
+    # frequency/phase drift, a condition-dependent nuisance peak, and noise
+    import numpy.random as random
+
+    rng = random.RandomState(seed)
+    dt = 1.0 / 2200.0
+    n = 512
+    time_axis = numpy.arange(n) * dt
+    reference = numpy.zeros(n, 'complex')
+    for frequency, amplitude, fwhm in [(-400, 30, 18), (-180, 260, 22), (60, 55, 25), (210, 140, 20)]:
+        damping = numpy.exp(-numpy.pi ** 2 * fwhm ** 2 * time_axis ** 2 / (4 * numpy.log(2)))
+        reference += amplitude * numpy.exp(2j * numpy.pi * frequency * time_axis) * damping
+    series = []
+    for index, (frequency, phase) in enumerate(drifts):
+        transient = reference * numpy.exp(2j * numpy.pi * (frequency * time_axis + phase))
+        if nuisance is not None and index != corrupt_index:
+            for frequency2, amplitude2, fwhm2 in nuisance:
+                damping = numpy.exp(-numpy.pi ** 2 * fwhm2 ** 2 * time_axis ** 2 / (4 * numpy.log(2)))
+                transient = transient + amplitude2 * numpy.exp(2j * numpy.pi * frequency2 * time_axis) * damping
+        if index == corrupt_index:
+            transient = numpy.exp(2j * numpy.pi * 300.0 * time_axis) * numpy.exp(-time_axis / (0.1 * n * dt))
+        transient = transient + noise * (rng.randn(n) + 1j * rng.randn(n))
+        series.append(suspect.MRSData(transient, dt, 123))
+    return suspect.MRSData(reference, dt, 123), series
+
+
+def test_dynamic_registration_corrects_drift():
+    drifts = [(22.4, 0.18), (-19.6, -0.21), (31.0, -0.15), (-12.0, 0.12), (25.5, 0.31)]
+    reference, series = _synthetic_dynamic_series(
+        drifts, noise=0.4, nuisance=[(260, 90, 20), (-320, 60, 18)]
+    )
+    result = suspect.processing.frequency_correction.register_dynamic_series(
+        series,
+        reference=reference,
+        initial_guesses=[(frequency * 1.2, phase) for frequency, phase in drifts],
+        frequency_range=(-250, -110),
+        reject_threshold=0.42,
+    )
+    estimates = result['estimates']
+    numpy.testing.assert_allclose(estimates[:, 0], [frequency for frequency, _ in drifts], atol=1.0)
+    numpy.testing.assert_allclose(estimates[:, 1], [phase for _, phase in drifts], atol=0.1)
+    assert numpy.all(result['residuals_after'] < result['residuals_before'])
+    assert numpy.mean(result['residuals_after']) < 0.2
+    assert numpy.all(result['accepted'])
+
+
+def test_dynamic_registration_rejects_unusable_transient():
+    drifts = [(22.4, 0.18), (-19.6, -0.21), (31.0, -0.15), (-12.0, 0.12), (25.5, 0.31)]
+    reference, series = _synthetic_dynamic_series(
+        drifts, noise=0.4, nuisance=[(260, 90, 20), (-320, 60, 18)], corrupt_index=2
+    )
+    result = suspect.processing.frequency_correction.register_dynamic_series(
+        series,
+        reference=reference,
+        frequency_range=(-250, -110),
+        reject_threshold=0.42,
+    )
+    expected = numpy.array([True, True, False, True, True])
+    numpy.testing.assert_array_equal(result['accepted'], expected)
+    assert result['residuals_after'][2] > 0.42
+    assert numpy.all(result['residuals_after'][expected] < 0.42)
