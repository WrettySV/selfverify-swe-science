# Copy to ~/.config/swe-bench-science/vllm-qwen38.env and chmod 600.
#
# CRITICAL: vLLM --max-model-len and Codex model_context_window MUST match.
# If Codex thinks the window is ~258k (fallback) but vLLM caps at 128k,
# peak_context_tokens silently hits the server limit.

OPENAI_API_KEY=local-vllm

# Must match --served-model-name from the vLLM launch script.
MODEL=Qwen3.8-27B

# Pier/Codex runs inside Docker — use the docker0 bridge IP, not 127.0.0.1.
CODEX_BASE_URL=http://172.17.0.1:8001/v1
CODEX_WIRE_API=responses
CODEX_VERSION=0.154.0
CODEX_REASONING_EFFORT=xhigh

# Align Codex's notion of context with vLLM max-model-len (262144).
# Injected into config.toml by scripts/render_vllm_codex_config note /
# or via --agent-kwarg when using an extended provider renderer.
# Our run path uses SWE-bench Science provider_config; set this explicitly
# by appending to config via CODEX_EXTRA_TOML if your wrapper supports it.
# For this repo, scripts/run_experiment.py relies on profiles that document
# the required key; prefer starting vLLM at 262144 and patching config.toml
# through a local provider override (see docs/context-window.md).
CODEX_MODEL_CONTEXT_WINDOW=262144
